# Demo sandbox for `repos launch`.
# direnv pins REPOS_DIR to the synthetic example repos whenever you are inside
# examples/ or any directory beneath it — never your real ~/repos.
#
# Resolve the .envrc's own directory (absolute) so REPOS_DIR stays correct no
# matter how deep you cd. $PWD would break "and deeper"; $DIRENV_FILE does not.
example_root="$(cd "$(dirname "$DIRENV_FILE")" && pwd)"
export REPOS_DIR="$example_root/acme-repos"

# Sensible demo default: allow the launch hook to jump on a moderate-confidence
# match. Override in your shell if you want it stricter.
export JEV_CONFIDENCE="${JEV_CONFIDENCE:-0.5}"

# REPOS_TYPESAFE_API_KEY (or the JEV_KEY testing alias) still comes from the
# worktree's .env — this file intentionally does not read or store secrets.

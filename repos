      esac
    done | sort -u
}

_repos_completions() {
  local state line
  typeset -A opt_args
  if ((CURRENT == 2)) && [[ $words[CURRENT] != -* ]]; then
    _values 'command' clone create init help
    return
  fi
  case $words[2] in
    init)
      _values 'shell' bash zsh
      ;;
    clone | create)
      if [[ $words[CURRENT] == -* ]]; then
        _values 'flag' '--bare' '--no-bare'
      else
        _files -/
      fi
      ;;
    *)
      _files
      ;;
  esac
}

_repos_r_completions() {
  local -a dirs
  local d
  while IFS= read -r d; do
    [[ -n $d ]] || continue
    if [[ -z $PREFIX || $d == "$PREFIX"* || ${d:t} == "$PREFIX"* ]]; then
      dirs+=("$d")
    fi
  done < <(_repos_repo_dirs)
  (( ${#dirs[@]} )) && compadd -a dirs
}

if (( $+functions[compdef] )); then
  compdef _repos_completions repos
  compdef _repos_r_completions r
fi
REPOS_INIT_ZSH
      ;;
  esac

  cat <<EOF
# =============================================================================
#
# To initialize repos, add this to your shell configuration file:
#
# eval "\$\(repos init $shell\)"
EOF
}

main() {
  case "${1:-}" in
    clone) shift; _repos_clone "$@" ;;
    create) shift; _repos_create "$@" ;;
    launch) shift; _launch "$@" ;;
    init) shift; _init "$@" ;;
    help|-h|--help) usage ;;
    "") _repos ;;
    *) printf 'repos: unknown command: %s\n' "$1" >&2; usage >&2; return 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi

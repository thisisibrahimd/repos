#!/usr/bin/env bash
set -eu -o pipefail

REPOS_DIR="${REPOS_DIR:-$HOME/repos}"

# Jev (typesafe.ai) System One API — used only by `repos launch`.
JEV_ENDPOINT="${JEV_ENDPOINT:-https://api.typesafe.ai/v1/systemone}"
JEV_MODEL="${JEV_MODEL:-jev-latest}"
# Minimum calibrated confidence for launch to move you without asking.
JEV_CONFIDENCE="${JEV_CONFIDENCE:-0.5}"

# Shell function shipped to the user's shell via `repos init`. It cannot cd
# from a child process, so it asks the picker for a path and cds itself.
r() {
  local dir
  dir=$(command repos) || return
  if [[ -n "$dir" ]]; then
    builtin cd -- "$dir"
  fi
}

# Jump to a repo described in plain language, or fall through to the picker.
rl() {
  local dir
  if dir=$(command repos launch "$@"); then
    if [[ -n "$dir" ]]; then
      builtin cd -- "$dir"
      return
    fi
  fi
  # No confident match — fall through to the picker, never a dead end.
  r
}

# --- helpers ---------------------------------------------------------------

# Resolve whether a git directory is bare or a work tree, by content:
# non-bare holds a .git entry (file or dir), a bare git dir holds HEAD.
# Echoes "bare", "work", or nothing.
_repos_kind() {
  if [[ -e "$1/.git" ]]; then
    printf 'work'
  elif [[ -f "$1/HEAD" ]]; then
    printf 'bare'
  fi
}

# Print absolute paths of every repo under REPOS_DIR, detected by content.
# Shared by the picker and by `repos launch` so both see the same set.
_repos_repo_dirs() {
  find "$REPOS_DIR" -mindepth 2 -type d \
    \( \( -name '*.git' ! -name '.git' -exec test -e '{}/HEAD' \; \) \
       -o -exec test -e '{}/.git' \; \) \
    -prune -print
}

# Parse a clone/create source into _SRC_HOST/_SRC_OWNER/_SRC_REPO/_SRC_URL.
# Accepted forms:
#   https://host/owner[/subgroup...]/repo[.git][/]
#   http://host/owner/repo.git
#   git@host:owner[/subgroup...]/repo[.git]
#   ssh://git@host/owner[/subgroup...]/repo[.git]
#   owner/repo                     (shorthand, host defaults to github.com)
#   host/owner[/subgroup...]/repo  (first segment containing a dot = host)
# Shorthand sources are rebuilt as canonical ssh clone URLs:
#   git@host:owner/repo.git
_repos_parse_source() {
  local src="$1" rest host path owner repo seg shorthand=0
  _SRC_HOST="" _SRC_OWNER="" _SRC_REPO="" _SRC_URL=""

  # Never hand git an argument starting with "-": it would parse as an option.
  case "$src" in
    -*)
      printf 'repos: source must not start with "-": %s\n' "$src" >&2
      return 1
      ;;
    # Reject exotic transports (ext::, fork::, capture::...) that execute
    # commands, and anything else with a doubled colon.
    *::* | *:/*:*)
      printf 'repos: unsupported source scheme: %s\n' "$src" >&2
      printf 'accepted: <https-url> | <ssh-url> | [host/]owner/repo\n' >&2
      return 1
      ;;
  esac

  # Explicit transport schemes must be git-protocol schemes.
  if [[ "$src" == *://* ]]; then
    local scheme=${src%%://*}
    case "$scheme" in
      http | https | ssh | git) : ;;
      *)
        printf 'repos: unsupported scheme "%s": %s\n' "$scheme" "$src" >&2
        return 1
        ;;
    esac
  fi

  case "$src" in
    https://*|http://*|git://*)
      rest=${src#*://}
      ;;
    ssh://*)
      rest=${src#ssh://}
      # strip optional [user@] before the host
      if [[ "${rest%%/*}" == *@* ]]; then
        rest=${rest#*@}
      fi
      ;;
    *:*/*)
      # scp-style [user@]host:path
      local scp_host=${src%%:*}
      scp_host=${scp_host#*@}
      rest="$scp_host/${src#*:}"
      ;;
    */*)
      # shorthand: [host/]owner[/subgroup...]/repo
      if [[ "${src%%/*}" == *.* ]]; then
        rest=$src
        shorthand=1
      elif [[ "$src" != */*/* ]]; then
        rest="github.com/$src"
        shorthand=1
      else
        printf 'repos: cannot parse source: %s\n' "$src" >&2
        printf 'accepted: <https-url> | <ssh-url> | [host/]owner/repo\n' >&2
        return 1
      fi
      ;;
    *)
      printf 'repos: cannot parse source: %s\n' "$src" >&2
      printf 'accepted: <https-url> | <ssh-url> | [host/]owner/repo\n' >&2
      return 1
      ;;
  esac

  # strip trailing slashes and .git suffix
  while [[ "$rest" == */ ]]; do rest=${rest%/}; done
  rest=${rest%.git}

  host=${rest%%/*}
  path=${rest#*/}

  if [[ -z "$host" || -z "$path" || "$path" == "$rest" || "$path" == */ || "$path" == /* ]]; then
    printf 'repos: cannot parse source: %s\n' "$src" >&2
    printf 'accepted: <https-url> | <ssh-url> | [host/]owner/repo\n' >&2
    return 1
  fi

  repo=${path##*/}
  owner=${path%/*}

  # Validate every owner/repo segment: no empty, no dot traversal, and no
  # tab/newline (those corrupt the picker's tab-separated label columns).
  if [[ -z "$repo" || -z "$owner" || "$owner" == "$path" || "$owner" == /* || "$path" == */ ]]; then
    printf 'repos: cannot parse source: %s\n' "$src" >&2
    printf 'accepted: <https-url> | <ssh-url> | [host/]owner/repo\n' >&2
    return 1
  fi
  local tocheck="$host/$owner/$repo"
  while [[ -n "$tocheck" ]]; do
    seg=${tocheck%%/*}
    if [[ "$seg" == "$tocheck" ]]; then
      tocheck=""
    else
      tocheck=${tocheck#*/}
    fi
    if [[ -z "$seg" || "$seg" == "." || "$seg" == ".." || "$seg" == *$'\t'* || "$seg" == *$'\n'* ]]; then
      printf 'repos: invalid path segment in source: %s\n' "$src" >&2
      return 1
    fi
  done

  _SRC_HOST="$host"
  _SRC_OWNER="$owner"
  _SRC_REPO="$repo"
  if [[ "$shorthand" == "1" ]]; then
    printf -v _SRC_URL 'git@%s:%s/%s.git' "$host" "$owner" "$repo"
  else
    _SRC_URL="$src"
  fi
}

# Resolve bare flag: $1 = "1"/"0" from CLI (empty = not given), else
# REPOS_BARE env (default "1"). Echoes "1" or "0".
_repos_resolve_bare() {
  local flag="${1:-}" v
  if [[ -n "$flag" ]]; then
    printf '%s' "$flag"
    return 0
  fi
  v="${REPOS_BARE:-1}"
  case "$v" in
    1|true) printf '1' ;;
    0|false) printf '0' ;;
    *)
      printf 'repos: invalid REPOS_BARE: %s (use 0/1/true/false)\n' "$v" >&2
      return 2
      ;;
  esac
}

# Parse shared flags for clone/create. Sets _OPT_BARE_FLAG ("", "1", "0")
# and _OPT_ARGS (positional args). Returns 2 on bad or help flags.
_repos_parse_flags() {
  _OPT_BARE_FLAG=""
  _OPT_ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bare) _OPT_BARE_FLAG=1 ;;
      --no-bare) _OPT_BARE_FLAG=0 ;;
      -h|--help) return 2 ;;
      --*) printf 'repos: unknown flag: %s\n' "$1" >&2; return 2 ;;
      *) _OPT_ARGS+=("$1") ;;
    esac
    shift
  done
  return 0
}

# Destination path for $REPOS_DIR layout: <dir>/<host>/<owner>/<repo>[.git]
# Args: $1=bare("1"/"0"). Uses _SRC_HOST/_SRC_OWNER/_SRC_REPO.
_repos_dest() {
  local dest="$REPOS_DIR/$_SRC_HOST/$_SRC_OWNER/$_SRC_REPO"
  if [[ "$1" == "1" ]]; then
    dest="$dest.git"
  fi
  printf '%s' "$dest"
}

# --- commands --------------------------------------------------------------

_repos_clone() { _repos_add clone "$@"; }
_repos_create() { _repos_add create "$@"; }

# Shared implementation for clone/create. $1 = "clone" | "create".
_repos_add() {
  local cmd="$1"; shift
  local usage_line
  if [[ "$cmd" == clone ]]; then
    usage_line='usage: repos clone [--bare|--no-bare] <url|owner/repo>'
  else
    usage_line='usage: repos create [--bare|--no-bare] <[host/]owner/repo>'
  fi

  local rc=0
  _repos_parse_flags "$@" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    printf '%s\n' "$usage_line" >&2
    return "$rc"
  fi
  set -- "${_OPT_ARGS[@]+"${_OPT_ARGS[@]}"}"
  if [[ $# -ne 1 ]]; then
    printf '%s\n' "$usage_line" >&2
    return 2
  fi

  command -v git >/dev/null 2>&1 || { printf 'repos: git not found in PATH\n' >&2; return 1; }

  _repos_parse_source "$1" || return 1

  local bare
  rc=0
  bare=$(_repos_resolve_bare "$_OPT_BARE_FLAG") || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    return "$rc"
  fi

  local dest
  dest=$(_repos_dest "$bare")
  # Defense in depth: a parsed path must stay inside REPOS_DIR.
  case "$dest" in
    "$REPOS_DIR"/*) : ;;
    *)
      printf 'repos: refusing destination outside REPOS_DIR: %s\n' "$dest" >&2
      return 1
      ;;
  esac
  if [[ -e "$dest" ]]; then
    printf 'repos: destination already exists: %s\n' "$dest" >&2
    return 1
  fi

  mkdir -p "$(dirname "$dest")"
  if [[ "$cmd" == clone ]]; then
    if [[ "$bare" == "1" ]]; then
      git clone --bare -- "$_SRC_URL" "$dest" >&2 || return 1
    else
      git clone -- "$_SRC_URL" "$dest" >&2 || return 1
    fi
  else
    if [[ "$bare" == "1" ]]; then
      git init --bare -- "$dest" >&2 || return 1
    else
      git init -- "$dest" >&2 || return 1
    fi
  fi
  printf '%s\n' "$dest"
}

_repos() {
  if [[ ! -d "$REPOS_DIR" ]]; then
    printf 'Repository directory not found: %s\n' "$REPOS_DIR" >&2
    return 1
  fi
  if ! command -v fzf >/dev/null 2>&1; then
    printf 'fzf not found in PATH\n' >&2
    return 1
  fi
  if ! command -v git >/dev/null 2>&1; then
    printf 'git not found in PATH\n' >&2
    return 1
  fi

  local tab=$'\t'
  local sel
  sel=$(
    _repos_repo_dirs |
    while IFS= read -r d; do
      rel=${d#"$REPOS_DIR/"}
      # A directory name containing a tab would corrupt the label columns.
      # bash 3.2 cannot parse *"$tab"* in a case pattern; use [[ ]].
      if [[ "$rel" == *"$tab"* ]]; then continue; fi
      kind=$(_repos_kind "$d")
      printf '%s%s(%s)\n' "$rel" "$tab" "$kind"
    done |
    sort |
    fzf --delimiter "$tab" --with-nth 1
  ) || return 0
  sel=${sel%%"$tab"*}
  [[ -n "$sel" ]] || return 0

  # Resolve symlinks so paths match `git worktree list` output exactly.
  local abs
  abs=$(cd "$REPOS_DIR/$sel" 2>/dev/null && pwd -P) || return 0
  local worktrees n=0
  worktrees=$(git -C "$abs" worktree list --porcelain 2>/dev/null) || worktrees=""
  while IFS= read -r line; do
    case "$line" in worktree\ *) n=$((n + 1)) ;; esac
  done <<<"$worktrees"

  # A bare repo or work tree with no extra worktrees: hop straight in.
  if [[ "$n" -le 1 ]]; then
    printf '%s' "$abs"
    return 0
  fi

  # Two or more worktrees: pick which one to enter.
  local -a wt_paths=()
  local -a wt_labels=()
  local i=0 p
  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        p=${line#worktree }
        wt_paths+=("$p")
        if [[ "$p" == "$abs" ]]; then
          local kind
          kind=$(_repos_kind "$abs")
          wt_labels+=("${sel##*/}${tab}(${kind})")
        else
          wt_labels+=("${p#"$abs/"}${tab}(worktree)")
        fi
        i=$((i + 1))
        ;;
    esac
  done <<<"$worktrees"

  sel=$(
    for i in "${!wt_labels[@]}"; do
      printf '%s%s%s\n' "${wt_labels[$i]}" "$tab" "$i"
    done |
    fzf --delimiter "$tab" --with-nth 1..2
  ) || return 0
  local idx=${sel##*"$tab"}
  printf '%s' "${wt_paths[$idx]}"
}

#######################################
# Resolve the TypeSafe/Jev API key from env vars or ./.env.
# Globals:
#   REPOS_TYPESAFE_API_KEY, JEV_KEY
# Arguments:
#   None
# Outputs:
#   Writes the API key to stdout.
#######################################
_jev_key() {
  if [[ -n "${REPOS_TYPESAFE_API_KEY:-}" ]]; then
    printf '%s' "$REPOS_TYPESAFE_API_KEY"
  elif [[ -n "${JEV_KEY:-}" ]]; then
    printf '%s' "$JEV_KEY"
  elif [[ -f .env ]]; then
    local pattern='REPOS_TYPESAFE_API_KEY|JEV_KEY'
    sed -nE "s/^[[:space:]]*(${pattern})[[:space:]]*=[[:space:]]*//p" .env \
      | head -1 \
      | tr -d '\r'
  fi
}

#######################################
# Build a one-line, tab/newline-free descriptor from cheap local git facts.
# Globals:
#   None
# Arguments:
#   abs: absolute path to the repository.
# Outputs:
#   Writes remote, README heading, branches, and commit subjects to stdout.
#######################################
_repo_descriptor() {
  local abs="$1" remote bare readme branches commits
  remote=$(git -C "$abs" config --get remote.origin.url 2>/dev/null || true)
  bare=$(git -C "$abs" rev-parse --is-bare-repository 2>/dev/null || true)
  branches=$(git -C "$abs" for-each-ref --count=6 \
    --format='%(refname:short)' refs/heads 2>/dev/null \
    | tr '\n' ' ')
  commits=$(git -C "$abs" log --no-merges -3 --pretty=%s 2>/dev/null \
    | tr '\n' ' ')
  if [[ "$bare" == "true" ]]; then
    readme=$(git -C "$abs" show HEAD:README.md 2>/dev/null \
      | grep -m1 '^#')
  else
    readme=$(head -30 "$abs/README.md" "$abs/README" "$abs/readme.md" \
      2>/dev/null \
      | grep -m1 '^#')
  fi
  # host/owner/name is already the choice key; the descriptor adds signal.
  printf 'remote=%s | readme="%s" | branches=%s | recent=%s' \
    "${remote:-none}" "${readme:-}" "${branches:-none}" "${commits:-none}" \
    | tr '\t\n' '  '
}

#######################################
# Resolve a plain-language description to one repo via a Jev Choice call.
# Globals:
#   REPOS_DIR, JEV_ENDPOINT, JEV_MODEL, JEV_CONFIDENCE
# Arguments:
#   description: the work to match against local repo descriptors.
# Outputs:
#   Writes the chosen absolute repo path to stdout; errors to stderr.
# Returns:
#   0 on a confident match, 2 on usage error, 1 on failure or abstention.
#######################################
_launch() {
  local description="${1:-}"
  if [[ -z "$description" ]]; then
    printf 'usage: repos launch "<plain-language description>"\n' >&2
    return 2
  fi
  if [[ ! -d "$REPOS_DIR" ]]; then
    printf 'Repository directory not found: %s\n' "$REPOS_DIR" >&2
    return 1
  fi

  local key
  key=$(_jev_key)
  if [[ -z "$key" ]]; then
    printf 'launch: no REPOS_TYPESAFE_API_KEY set (env or ./.env) — ' >&2
    printf 'falling back to fuzzy picker\n' >&2
    printf 'Tip: r  (no key needed)\n' >&2
    return 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    printf 'launch: jq not found in PATH\n' >&2
    return 1
  fi
  if ! command -v curl >/dev/null 2>&1; then
    printf 'launch: curl not found in PATH\n' >&2
    return 1
  fi

  # Build a "rel<TAB>descriptor" table for every repo, using the same
  # content-based discovery as the picker.
  local table rel abs
  table=""
  while IFS= read -r abs; do
    rel="${abs#"$REPOS_DIR"/}"
    table+="$rel"$'\t'"$(_repo_descriptor "$abs")"$'\n'
  done < <(_repos_repo_dirs | sort)

  if [[ -z "$table" ]]; then
    printf 'launch: no repositories under %s\n' "$REPOS_DIR" >&2
    return 1
  fi

  # One Jev Choice call: state=description, criteria=every repo plus an
  # explicit "none" so the model can abstain.
  local body instructions
  instructions='The state is a description of work someone was doing. '
  instructions+='Choose the single repository whose descriptor best matches '
  instructions+='that work; a criterion key is host/owner/name and its value '
  instructions+='describes the repo. Choose none only if nothing plausibly '
  instructions+='matches.'
  body=$(printf '%s' "$table" \
    | jq -Rs --arg state "$description" --arg model "$JEV_MODEL" \
      --arg instructions "$instructions" '
        split("\n") | map(select(length > 0)) | map(split("\t")) |
        (map({ (.[0]): .[1] }) +
         [{ "none": "No repository matches this description." }]
         | add) as $crit |
        { state: $state,
          model: $model,
          questions: { pick: {
            type: "choice",
            instructions: $instructions,
            criteria: $crit
          } } }
      ')

  local resp http_code
  resp=$(curl --silent --show-error --fail-with-body \
    -w $'\n%{http_code}' \
    "$JEV_ENDPOINT" \
    -H "Authorization: Bearer $key" \
    -H "Content-Type: application/json" \
    --data-binary "$body" 2>/dev/null) || {
      printf 'launch: Jev request failed\n' >&2
      return 1
    }
  http_code=${resp##*$'\n'}
  resp=${resp%$'\n'*}
  if [[ "$http_code" != 2* ]]; then
    printf 'launch: Jev HTTP %s\n' "$http_code" >&2
    printf '%s\n' "$resp" \
      | jq -r '.error.message // .error // "no message"' >&2 2>/dev/null \
      || printf '%s\n' "$resp" >&2
    return 1
  fi

  local choice confidence
  choice=$(printf '%s' "$resp" | jq -r '.answers.pick.choice // "none"')
  confidence=$(printf '%s' "$resp" | jq -r '.answers.pick.confidence // 0')

  if [[ "$choice" == "none" ]]; then
    printf 'launch: no repo matched "%s"\n' "$description" >&2
    return 1
  fi

  # Below the confidence floor, surface the ranked candidates and abstain
  # (the rl hook falls back to the picker). Never a silent wrong jump.
  local high
  high=$(printf '%s' "$confidence" \
    | jq -r --argjson f "$JEV_CONFIDENCE" '. >= $f')
  if [[ "$high" != "true" ]]; then
    printf 'launch: low confidence (%s) for "%s" → candidates:\n' \
      "$confidence" "$description" >&2
    printf '%s' "$resp" \
      | jq -r '.answers.pick.probabilities
        | to_entries
        | sort_by(-.value)[]
        | "\(.key)  (\(.value))"' >&2
    return 1
  fi

  printf '%s' "$REPOS_DIR/$choice"
}

usage() {
  cat <<'EOF'
repos — hop between your repos with ease

Env:
  REPOS_DIR               Directory containing repositories in URL format (default: $HOME/repos).
  REPOS_BARE              Default for clone/create: 1/true clones bare with a .git suffix,
                          0/false clones with a work tree. Default: 1. Flags override.
  JEV_KEY                 TypeSafe API key. Enables `repos launch`. Falls back to
                          fuzzy picker when unset.
  JEV_CONFIDENCE          Min calibrated confidence (0-1) for launch to jump
                          without asking (default: 0.5).

Layout:
  <repos-dir>/<git-host-domain>/<repo-owner>/<repo-name>[.git]
  Bare and non-bare repos are detected by content, so owner subgroups
  (e.g. gitlab.com/group/subgroup/repo) are supported at any depth.

Usage:
  r                                    Pick repo (then worktree, if any) and cd into it.
  rl "<description>"                   Jump to the repo matching a plain-language
                                       description (needs JEV_KEY).
  repos                                Print picked repo dir (used by shell hook: r).
  repos launch "<desc>"                Print the matching repo dir via Jev, or nothing
                                       (used by hook: rl).
  repos clone [flags] <src>            Clone into the layout, print the path.
                                       <src>: <https-url> | <ssh-url> | [host/]owner/repo
  repos create [flags] <owner/repo>    Init a new repo into the layout, print the path.
  repos init [bash|zsh]                Print shell hook (r + tab completion).
  repos --help                         Print usage instructions.

Tab completion:
  The shell hook completes repos subcommands/flags, and r completes repository
  paths under REPOS_DIR (full path or repo name prefix). No runtime deps.

Clone/create flags:
  --bare                  Force a bare repository (default), name suffixed with .git.
  --no-bare               Force a repository with a work tree, no suffix.

Worktrees:
  repos lists worktrees of the picked repository and offers them, so r can hop
  straight into one. Create new worktrees with worktrunk: run `wt switch <branch>`
  inside a bare repo.
EOF
}

_init() {
  local shell=bash
  while [[ $# -gt 0 ]]; do
    case "$1" in
      bash|zsh) shell="$1" ;;
      *) printf 'repos init: unexpected shell: %s\n' "$1" >&2; return 2 ;;
    esac
    shift
  done

  printf '# repos init: %s\n' "$shell"
  declare -f r rl

  # Tab completion for `repos` and `r`. The candidate list mirrors the picker:
  # a dir under REPOS_DIR is a repo if it holds a .git entry or a HEAD file.
  # .git hits are pruned so a work tree's .git/HEAD never shows up; .worktrees
  # is pruned so worktree dirs stay out (repo-only completion, for now).
  case "$shell" in
    bash)
      cat <<'REPOS_INIT_BASH'
_repos_repo_dirs() {
  local root=${REPOS_DIR:-$HOME/repos}
  [ -d "$root" ] || return 0
  find "$root" -maxdepth 7 -mindepth 3 \
    \( -name .git -prune -print \) -o \
    \( -name .worktrees -prune \) -o \
    \( -type f -name HEAD -print \) 2>/dev/null |
    while IFS= read -r p; do
      case "$p" in
        */.git) printf '%s\n' "${p%/.git}" ;;
        *) printf '%s\n' "${p%/HEAD}" ;;
      esac
    done | sort -u
}

_repos_completions() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local i word sub=""
  for ((i = 1; i < COMP_CWORD; i++)); do
    word=${COMP_WORDS[i]}
    case $word in
      -*) ;;
      *) sub=$word; break ;;
    esac
  done
  COMPREPLY=()
  case $sub in
    '')
      mapfile -t COMPREPLY < <(compgen -W 'clone create init help' -- "$cur")
      ;;
    clone | create)
      if [[ $cur == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W '--bare --no-bare' -- "$cur")
      fi
      ;;
    init)
      mapfile -t COMPREPLY < <(compgen -W 'bash zsh' -- "$cur")
      ;;
  esac
  if ((${#COMPREPLY[@]} == 0)); then
    compopt -o default 2>/dev/null || true
  fi
}

_repos_r_completions() {
  local cur=${COMP_WORDS[COMP_CWORD]} d
  COMPREPLY=()
  while IFS= read -r d; do
    [[ -n $d && ($d == "$cur"* || ${d##*/} == "$cur"*) ]] && COMPREPLY+=("$d")
  done < <(_repos_repo_dirs)
  ((${#COMPREPLY[@]})) && compopt -o filenames 2>/dev/null || true
}

if command -v compgen >/dev/null 2>&1; then
  complete -F _repos_completions repos
  complete -F _repos_r_completions r
fi

name "repos"
bin "repos"
about "repos — hop between your repos with ease"

long_about #"""
Run repos with no arguments to pick a repo (then a worktree, if any) with fzf
and print its path. The shell hook (repos init) wraps that in an r function
which cds into the picked dir.

Layout:
  <repos-dir>/<git-host-domain>/<repo-owner>/<repo-name>[.git]
  Bare and non-bare repos are detected by content, so owner subgroups
  (e.g. gitlab.com/group/subgroup/repo) are supported at any depth.

Env:
  REPOS_DIR   Directory containing repositories in URL format (default: $HOME/repos).
  REPOS_BARE  Default for clone/create: 1/true clones bare with a .git suffix,
              0/false clones with a work tree. Default: 1. Flags override.

Worktrees:
  repos lists worktrees of the picked repository and offers them, so r can hop
  straight into one. Create new worktrees with worktrunk: run wt switch <branch>
  inside a bare repo.
"""#

example "r" header="Hop into a repo" help="Pick a repo (then a worktree) with fzf and cd into it"
example "repos clone markazos/markazos" header="Clone shorthand" help="Clone into the layout via ssh, bare by default"
example "repos create thisisibrahimd/my-new-repo" header="Create a repo" help="Init a new bare repo under your owner"

cmd "clone" help="Clone into the layout, print the path" {
  flag "--bare" help="Force a bare repository (default), name suffixed with .git"
  flag "--no-bare" help="Force a repository with a work tree, no suffix"
  arg "<src>" help="<https-url> | <ssh-url> | [host/]owner/repo" required
}

cmd "create" help="Init a new repo into the layout, print the path" {
  flag "--bare" help="Force a bare repository (default), name suffixed with .git"
  flag "--no-bare" help="Force a repository with a work tree, no suffix"
  arg "<owner/repo>" help="New repo path under your owner" required
}

cmd "init" help="Print shell hook" {
  arg "[shell]" help="Shell to emit the hook for" default="bash" choices "bash" "zsh"
}
